 	$psql_sessions[$i] = $node_standby->background_psql('postgres');
 	$psql_sessions[$i]->query_until(
 		qr/start/, qq[
@@ -572,7 +579,7 @@ for (my $i = 0; $i < 5; $i++)
 		"INSERT INTO wait_test VALUES (100 + ${i});");
 	$write_lsns[$i] =
