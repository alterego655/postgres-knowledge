From 32ad7baa3954a7626e782943c9816748a54ec49f Mon Sep 17 00:00:00 2001
From: alterego655 <824662526@qq.com>
Date: Tue, 22 Sep 2026 16:57:40 +0800
Subject: [PATCH] Use WAL insertion end positions in WAIT examples and tests

An insertion position can include the next WAL page's header even when
no record has been inserted there.  Waiting for that position can stall
until unrelated WAL is generated, despite all existing WAL being processed.

Use pg_current_wal_insert_end_lsn() in the WAIT and read-your-writes
examples and throughout 049_wait_for_lsn.pl.  Capturing the target after
COMMIT still covers asynchronous commits.  Preserve deliberate offsets,
future targets, and the existing controls on standby progress.
---
 doc/src/sgml/high-availability.sgml     | 11 +++--
 doc/src/sgml/ref/wait.sgml              | 16 ++++---
 src/test/recovery/t/049_wait_for_lsn.pl | 63 +++++++++++++++----------
 3 files changed, 53 insertions(+), 37 deletions(-)

diff --git a/doc/src/sgml/high-availability.sgml b/doc/src/sgml/high-availability.sgml
index 7253f9d8287..5d4144ec1ef 100644
--- a/doc/src/sgml/high-availability.sgml
+++ b/doc/src/sgml/high-availability.sgml
@@ -1411,12 +1411,15 @@ synchronous_standby_names = 'ANY 2 (s1, s2, s3)'
    <para>
     This is achieved by the following steps.  Once the write transaction
     has committed, the application retrieves a WAL location from the
-    primary using a function call like this.
+    primary using <function>pg_current_wal_insert_end_lsn</function>.
+    This position covers the commit even when
+    <varname>synchronous_commit</varname> is <literal>off</literal>, and
+    excludes the next page's header if the WAL ends at a page boundary.
 
 <programlisting>
-postgres=# SELECT pg_current_wal_insert_lsn();
- pg_current_wal_insert_lsn
----------------------------
+postgres=# SELECT pg_current_wal_insert_end_lsn();
+ pg_current_wal_insert_end_lsn
+-------------------------------
  0/306EE20
 (1 row)
 </programlisting>
diff --git a/doc/src/sgml/ref/wait.sgml b/doc/src/sgml/ref/wait.sgml
index 2917309c0d5..ebf4f6c631e 100644
--- a/doc/src/sgml/ref/wait.sgml
+++ b/doc/src/sgml/ref/wait.sgml
@@ -383,17 +383,19 @@ WAIT FOR LSN '<replaceable class="parameter">lsn</replaceable>'
    <literal>COMMIT</literal> record.  In the default autocommit mode shown
    here, the <command>UPDATE</command> commits before the subsequent
    <command>SELECT</command>.  This example uses
-   <function>pg_current_wal_insert_lsn</function> on primary server to get
-   the <acronym>lsn</acronym> given that
-   <varname>synchronous_commit</varname> could be set to
-   <literal>off</literal>.
+   <function>pg_current_wal_insert_end_lsn</function> on the primary to get
+   a position covering the commit even when
+   <varname>synchronous_commit</varname> is <literal>off</literal>.
+   At a WAL page boundary, this function returns the record end without
+   including the next page's header, so reaching the target does not require
+   another WAL record merely to cross that header.
 
    <programlisting>
 postgres=# UPDATE movie SET genre = 'Dramatic' WHERE genre = 'Drama';
 UPDATE 100
-postgres=# SELECT pg_current_wal_insert_lsn();
- pg_current_wal_insert_lsn
----------------------------
+postgres=# SELECT pg_current_wal_insert_end_lsn();
+ pg_current_wal_insert_end_lsn
+-------------------------------
  0/0306EE20
 (1 row)
 </programlisting>
diff --git a/src/test/recovery/t/049_wait_for_lsn.pl b/src/test/recovery/t/049_wait_for_lsn.pl
