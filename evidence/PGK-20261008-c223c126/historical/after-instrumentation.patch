 use PostgreSQL::Test::Cluster;
 use PostgreSQL::Test::Utils;
 use Test::More;
+use Time::HiRes qw(time);
+{
+ no warnings 'redefine';
+ my $orig = \&PostgreSQL::Test::Cluster::safe_psql;
+ *PostgreSQL::Test::Cluster::safe_psql = sub {
+  my $start = time();
+  my $ret = $orig->(@_);
+  my $q = $_[2]; $q =~ s/\s+/ /g;
+  note(sprintf("TIMING %.3f %s %s", time()-$start, $_[0]->name, substr($q,0,150)));
+  return $ret;
+ };
+}
